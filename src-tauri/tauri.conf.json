{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopServe",
  "version": "0.1.0",
  "identifier": "com.loopserve.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LoopServe",
        "width": 920,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/**/*"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDREUxNUU0MUUxNzkwOUIKUldTYmtCY2U1QlhlZklIS2t6RXNDbXBqSWlFazVkU0xhWmo3OG9HQVprK3FnR3hLaTUyZlB3REwK",
      "endpoints": [
        "https://github.com/crownemmanuel/LoopServe/releases/latest/download/latest.json"
      ]
    }
  }
}
